SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
FROM_EMAIL="CargoShare AI <no-reply@cargoshare.ai>"

# Razorpay Payment Gateway (Test Mode Only)
RAZORPAY_KEY_ID=rzp_test_your_key_id
